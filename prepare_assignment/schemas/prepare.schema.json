{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prepare-assignment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "jobs": {
      "type": "object",
      "patternProperties": {
        "^[_a-zA-Z][a-zA-Z0-9_-]*$": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "if": {
                    "type": "string"
                  },
                  "working-directory": {
                    "description": "Working directory of the step (relative to the prepare file)",
                    "type": "string"
                  },
                  "env": {
                    "description": "Environment variables for this step only",
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "continue-on-error": {
                    "description": "Do not fail the job if this step fails",
                    "type": "boolean"
                  },
                  "uses": {
                    "type": "string"
                  },
                  "with": {
                    "type": "object"
                  }
                },
                "required": [
                  "name",
                  "uses"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "if": {
                    "type": "string"
                  },
                  "working-directory": {
                    "description": "Working directory of the step (relative to the prepare file)",
                    "type": "string"
                  },
                  "env": {
                    "description": "Environment variables for this step only",
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "continue-on-error": {
                    "description": "Do not fail the job if this step fails",
                    "type": "boolean"
                  },
                  "run": {
                    "type": "string"
                  },
                  "shell": {
                    "description": "Shell used to execute 'run'",
                    "type": "string",
                    "enum": [
                      "bash",
                      "sh",
                      "pwsh",
                      "powershell",
                      "cmd",
                      "python"
                    ]
                  }
                },
                "required": [
                  "name",
                  "run"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "required": [
    "name",
    "jobs"
  ]
}
